# ---- HIMNISH RAIP D3 - EMU monitoring environment ----
PORT=8080

# Persistent state (users/EMUs/coaches/thresholds). On Railway attach a Volume
# and set DATA_DIR to its mount path so data survives redeploys.
DATA_DIR=./data

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_TTL=12h

# Ingestion key used by every Himnish LTE module / RUT200 push
DATA_API_KEY=himnish_emu_key_2025

# Synthetic data generator (no hardware). Leave false in production.
DEMO_MODE=false
DEMO_EMUS=2

# RUT200 IP pull poller interval in seconds (0 = disabled). Admin-editable at
# runtime via Dashboard → Admin → Thresholds → "Log interval (s)" (takes effect
# live, no restart). This env var only sets the starting default.
POLL_INTERVAL=20
CFG_LOG_INTERVAL=20

# Default alert thresholds (deg C) - admin can override at runtime in the UI
CFG_WARN_TEMP=70
CFG_HIGH_TEMP=80
CFG_CRIT_TEMP=90
CFG_OFFLINE_SECONDS=300
CFG_LOW_BATTERY=20
CFG_RETENTION_DAYS=1825

# ---- Email alerts (SMTP). If unset, email alerts run in dry-run/log mode ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- SMS alerts. Provider: log (dry-run) | fast2sms | msg91 | generic ----
SMS_PROVIDER=log
SMS_API_KEY=
SMS_SENDER=HMNISH
# For generic provider only: URL with {to} {message} {key} placeholders
SMS_URL=

# Escalation scan interval (seconds)
ESCALATION_INTERVAL=60

# ---- PostgreSQL / TimescaleDB (optional, recommended for production) ----
# When set, every reading is stored permanently and history survives restarts.
# On Railway: add a PostgreSQL plugin and it provides DATABASE_URL automatically.
DATABASE_URL=
# Hours of recent history to reload into memory on startup
BACKFILL_HOURS=6
# Set to 'require' if your Postgres needs SSL (some external providers do)
PGSSL=

# ---- Optional MQTT ingestion (only if you use an MQTT broker) ----
# When set, the app subscribes and ingests JSON messages alongside HTTP push.
MQTT_URL=
MQTT_TOPIC=himnish/emu/+/readings
MQTT_USERNAME=
MQTT_PASSWORD=

# ---- Data retention (optional) ----
# Purge readings older than N days (0 = keep forever). Needs PostgreSQL.
RETENTION_DAYS=0

# ---- Production hardening (optional) ----
# Redirect http->https (only if your host forwards x-forwarded-proto). Railway
# already serves https, so leave unset unless you specifically need the redirect.
FORCE_HTTPS=

# ---- Optional AI Copilot (LLM) ----
# Set these to enable natural-language answers in the Assistant tab. Any
# OpenAI-compatible chat-completions endpoint works. Without a key, the
# Assistant uses the built-in rule-based logic.
LLM_API_KEY=
LLM_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
